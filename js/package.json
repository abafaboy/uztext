{
  "name": "uztext",
  "version": "0.1.0",
  "description": "Uzbek text toolkit: Cyrillic, current Latin and the 2026 new Latin alphabet (Ö Ğ Ş Ç), apostrophe normaliser, search keys, amounts in words.",
  "keywords": ["uzbek", "transliteration", "cyrillic", "latin", "alphabet", "o'zbek", "normalization"],
  "license": "MIT",
  "author": "Abdulfayyod Mukhamedov",
  "homepage": "https://github.com/abafaboy/uztext#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abafaboy/uztext.git",
    "directory": "js"
  },
  "bugs": "https://github.com/abafaboy/uztext/issues",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs",
    "build:web": "npm run build && node scripts/build-web.mjs",
    "test": "npm run build && node --test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
